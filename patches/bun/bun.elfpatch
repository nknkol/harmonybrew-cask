# Bun AArch64 in-memory ELF patch configuration
PROGRAM @PROGRAM@
INTERP  @GLIBC_INTERP@
RUNPATH @GLIBC_LIB@

# 1. close_range(start_fd, INT_MAX, CLOEXEC): force Bun's fd-loop fallback
TARGET close_range_fallback REQUIRED
  SEARCH 80368052e103??2a0200b01283008052????????000100b4 16 1f2003d5
  SEARCH 80368052e103??2a0200b01283008052????????????????000100b4 16 1f2003d5
  OFFSET 0x1d12c5c 80368052e103142a0200b01283008052193b2c95000100b4 ????????????????????????????????1f2003d5

# 2. Generic close_range wrapper: return -1 (x0 = -1; ret)
TARGET close_range_wrapper REQUIRED
  SEARCH fd7bbfa9fd030091e303022ae203012ae103002a80368052fd7bc1a8 20 00008092????????c0035fd6
  OFFSET 0x31c7f20 fd7bbfa9fd030091e303022ae203012ae103002a80368052fd7bc1a86566d914 ????????????????????????????????????????00008092????????c0035fd6

# 3. close_range(3, ~0U, CLOEXEC)
TARGET close_range_fd3 REQUIRED
  SEARCH 80368052610080520200801283008052 16 1f2003d5
  OFFSET 0x31c7fcc 803680526100805202008012830080523d66d994 ????????????????????????????????1f2003d5

# 4. Process init close_range(4, ~0U, CLOEXEC)
TARGET process_init_close_range REQUIRED
  SEARCH 8036805281008052020080128300805213008012 20 1f2003d5
  SEARCH 80368052810080520200801283008052 16 1f2003d5
  OFFSET 0x1831c9c 8036805281008052020080128300805209bf3f95 ????????????????????????????????1f2003d5
