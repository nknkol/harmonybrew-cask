+SEC_SRCS := \
+  $(T)/third_party_bounds_checking_function/src/memcpy_s.c \
+  $(T)/third_party_bounds_checking_function/src/memset_s.c \
+  $(T)/third_party_bounds_checking_function/src/sprintf_s.c \
+  $(T)/third_party_bounds_checking_function/src/snprintf_s.c \
+  $(T)/third_party_bounds_checking_function/src/vsprintf_s.c \
+  $(T)/third_party_bounds_checking_function/src/vsnprintf_s.c \
+  $(T)/third_party_bounds_checking_function/src/strcpy_s.c \
+  $(T)/third_party_bounds_checking_function/src/strcat_s.c \
+  $(T)/third_party_bounds_checking_function/src/strncat_s.c \
+  $(T)/third_party_bounds_checking_function/src/strncpy_s.c \
+  $(T)/third_party_bounds_checking_function/src/securecutil.c \
+  $(T)/third_party_bounds_checking_function/src/secureprintoutput_a.c
+
+OBJS := $(patsubst %.cpp, $(BLD)/%.o, $(SRCS))
+CJSON_OBJ := $(patsubst %.c, $(BLD)/%.o, $(CJSON_SRC))
+MINIZIP_OBJS := $(patsubst %.c, $(BLD)/%.o, $(MINIZIP_SRCS))
+SEC_OBJS := $(patsubst %.c, $(BLD)/%.o, $(SEC_SRCS))
+
+OPENSSL_LIBS := $(T)/openssl/libssl.a $(T)/openssl/libcrypto.a
+OPENSSL_CONF := $(T)/openssl/include/openssl/opensslconf.h
+LDFLAGS := -L$(ZLIB_PREFIX)/lib -lz -ldl -lpthread
+
+TARGET := $(BLD)/hap-sign-tool
+
+.PHONY: all clean
+
+all: $(TARGET)
+
+$(BLD)/%.o: %.cpp | $(OPENSSL_CONF)
+	@mkdir -p $(dir $@)
+	@echo "[CXX] $<"
+	@$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@
+
+$(BLD)/%.o: %.c | $(OPENSSL_CONF)
+	@mkdir -p $(dir $@)
+	@echo "[CC]  $<"
+	@$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@
+
+$(TARGET): $(OBJS) $(CJSON_OBJ) $(MINIZIP_OBJS) $(SEC_OBJS) $(OPENSSL_LIBS)
+	@echo "[LD]  $@"
+	@$(CXX) $(CXXFLAGS) $(OBJS) $(CJSON_OBJ) $(MINIZIP_OBJS) $(SEC_OBJS) $(LDFLAGS) -Wl,--whole-archive $(OPENSSL_LIBS) -Wl,--no-whole-archive -o $@
+
+$(OPENSSL_CONF):
+	@echo "[CONF] OpenSSL 1.1.1"
+	export AR=$$(which llvm-ar); cd $(T)/openssl && ./Configure linux-aarch64 no-shared no-tests --prefix=$(T)/openssl/install --openssldir=$(T)/openssl/install
+	cd $(T)/openssl && perl -I. -Mconfigdata util/dofile.pl -oMakefile include/openssl/opensslconf.h.in > include/openssl/opensslconf.h
+	@test -f $(OPENSSL_CONF) || (echo "FATAL: opensslconf.h not generated" && exit 1)
+
+$(T)/openssl/libssl.a $(T)/openssl/libcrypto.a: $(OPENSSL_CONF)
+	$(MAKE) -C $(T)/openssl -j4
+
+clean:
+	rm -rf $(BLD)
