+// compatibility header for standalone compilation
+#ifndef STANDALONE_COMPAT_H
+#define STANDALONE_COMPAT_H
+
+#include <cstdint>
+#include <cinttypes>
+#include <cstddef>
+#include <algorithm>
+#include <string>
+#include <vector>
+#include <memory>
+#include <list>
+#include <map>
+#include <set>
+#include <sstream>
+#include <fstream>
+#include <iostream>
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+#include <cmath>
+
+// OpenSSL 1.1.1 compat: ERR_set_error was added in 3.0
+#include <openssl/err.h>
+#ifndef ERR_set_error
+#define ERR_set_error(lib, reason, fmt, ...) \
+    ERR_put_error((lib), 0, (reason), __FILE__, __LINE__)
+#endif
+
+#endif
