+std::string HapUtils::GetPublicHnpOwnerId(const std::string& profileContent)
+{
+    std::pair<std::string, std::string> resultPair = ParseAppIdentifier(profileContent);
+    if (resultPair.second == "debug") {
+        return HAP_DEBUG_OWNER_ID;
+    }
+    if (resultPair.second == "release") {
+        return HAP_SHARED_OWNER_ID;
+    }
+    return "";
+}
+
+std::string HapUtils::ParseHnpPath(const std::string& path)
+{
+    if (path.empty()) {
+        return "";
+    }
+    std::vector<std::string> pathItems;
+    size_t startPos = 0;
+    size_t foundPos = path.find('/');
+    while (foundPos != std::string::npos) {
+        pathItems.emplace_back(path.substr(startPos, foundPos - startPos));
+        startPos = foundPos + 1;
+        foundPos = path.find('/', startPos);
+    }
+    pathItems.emplace_back(path.substr(startPos));
+    if (pathItems.size() < 3) {
+        return "";
+    }
+    std::string parsedPath = pathItems[2];
+    for (size_t i = 3; i < pathItems.size(); ++i) {
+        parsedPath += "/" + pathItems[i];
+    }
+    return parsedPath;
+}
+
+bool HapUtils::GetHnpsFromJson(const std::string& packagePath, std::unordered_map<std::string, std::string>& hnpMap)
+{
+    hnpMap.clear();
+    unzFile zFile = unzOpen(packagePath.c_str());
+    if (zFile == nullptr) {
+        PrintErrorNumberMsg("IO_ERROR", IO_ERROR, "zlib open file: " + packagePath + " failed.");
+        return false;
+    }
+    if (unzLocateFile(zFile, HAP_STAGE_MODULE_JSON_FILE.c_str(), 0) != UNZ_OK) {
+        unzClose(zFile);
+        return true;
+    }
+    if (unzOpenCurrentFile(zFile) != UNZ_OK) {
+        PrintErrorNumberMsg("SIGN_ERROR", SIGN_ERROR, "failed to open module.json in " + packagePath);
+        unzClose(zFile);
+        return false;
+    }
+    std::string moduleContent;
+    char readBuffer[4096] = {0};
+    int readLen = 0;
+    while ((readLen = unzReadCurrentFile(zFile, readBuffer, sizeof(readBuffer))) > 0) {
+        moduleContent.append(readBuffer, readLen);
+    }
+    unzCloseCurrentFile(zFile);
+    unzClose(zFile);
+    if (readLen < 0) {
+        PrintErrorNumberMsg("SIGN_ERROR", SIGN_ERROR, "failed to read module.json in " + packagePath);
+        return false;
+    }
+
+    cJSON* root = cJSON_ParseWithOpts(moduleContent.c_str(), nullptr, 1);
+    if (root == nullptr) {
+        PrintErrorNumberMsg("SIGN_ERROR", SIGN_ERROR, "module.json content is invalid in " + packagePath);
+        return false;
+    }
+    if (!cJSON_IsObject(root)) {
+        cJSON_Delete(root);
+        PrintErrorNumberMsg("SIGN_ERROR", SIGN_ERROR, "module.json content is invalid in " + packagePath);
+        return false;
+    }
+    cJSON* moduleObj = cJSON_GetObjectItemCaseSensitive(root, "module");
+    if (moduleObj == nullptr || !cJSON_IsObject(moduleObj)) {
+        cJSON_Delete(root);
+        return true;
+    }
+    cJSON* hnpPackages = cJSON_GetObjectItemCaseSensitive(moduleObj, "hnpPackages");
+    if (hnpPackages == nullptr || !cJSON_IsArray(hnpPackages)) {
+        cJSON_Delete(root);
+        return true;
+    }
+    cJSON* hnpPackageItem = nullptr;
+    cJSON_ArrayForEach(hnpPackageItem, hnpPackages) {
+        if (!cJSON_IsObject(hnpPackageItem)) {
+            continue;
+        }
+        cJSON* packageNameItem = cJSON_GetObjectItemCaseSensitive(hnpPackageItem, "package");
+        if (packageNameItem == nullptr || !cJSON_IsString(packageNameItem)) {
+            continue;
+        }
+        std::string packageName = packageNameItem->valuestring;
+        if (packageName.empty()) {
+            continue;
+        }
+        hnpMap[packageName] = "private";
+        cJSON* typeItem = cJSON_GetObjectItemCaseSensitive(hnpPackageItem, "type");
+        if (typeItem != nullptr && cJSON_IsString(typeItem)) {
+            std::string hnpType = typeItem->valuestring;
+            if (!hnpType.empty()) {
+                hnpMap[packageName] = hnpType;
+            }
+        }
+    }
+    cJSON_Delete(root);
+    return true;
+}
