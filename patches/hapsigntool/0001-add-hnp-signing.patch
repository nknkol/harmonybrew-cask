+bool CodeSigning::SignNativeHnps(const std::string& packageName, const std::string& profileContent,
+    const std::string& ownerID, std::vector<std::pair<std::string, SignInfo>>& ret)
+{
+    std::unordered_map<std::string, std::string> hnpTypeMap;
+    if (!HapUtils::GetHnpsFromJson(packageName, hnpTypeMap)) {
+        return false;
+    }
+    unzFile zFile = unzOpen(packageName.c_str());
+    if (zFile == nullptr) {
+        PrintErrorNumberMsg("IO_ERROR", IO_ERROR, "zlib open file: " + packageName + " failed.");
+        return false;
+    }
+    unz_global_info zGlobalInfo;
+    if (unzGetGlobalInfo(zFile, &zGlobalInfo) != UNZ_OK) {
+        PrintErrorNumberMsg("SIGN_ERROR", SIGN_ERROR, "zlib get global info failed.");
+        unzClose(zFile);
+        return false;
+    }
+    for (uLong i = 0; i < zGlobalInfo.number_entry; ++i) {
+        unz_file_info zFileInfo;
+        char fileName[FILE_NAME_SIZE] = {0};
+        if (unzGetCurrentFileInfo(zFile, &zFileInfo, fileName, FILE_NAME_SIZE, NULL, 0, NULL, 0) != UNZ_OK) {
+            PrintErrorNumberMsg("SIGN_ERROR", SIGN_ERROR, "unzip get file info failed!");
+            unzClose(zFile);
+            return false;
+        }
+        std::string entryName(fileName);
+        bool isDirectory = !entryName.empty() && entryName.back() == '/';
+        if (!isDirectory && IsHnpFile(entryName)) {
+            std::string hnpName = HapUtils::ParseHnpPath(entryName);
+            if (hnpTypeMap.find(hnpName) == hnpTypeMap.end()) {
+                PrintErrorNumberMsg("SIGN_ERROR", SIGN_ERROR,
+                    "Hnp file should be described in module.json: " + entryName);
+                unzClose(zFile);
+                return false;
+            }
+            std::string tempPath;
+            if (!CreateTempFilePath(HNP_SUFFIX, tempPath)) {
+                unzClose(zFile);
+                return false;
+            }
+            if (!ExtractCurrentFileToPath(zFile, tempPath)) {
+                std::remove(tempPath.c_str());
+                unzClose(zFile);
+                return false;
+            }
+            std::string currentOwnerID = ownerID;
+            if (hnpTypeMap[hnpName] == "public") {
+                currentOwnerID = HapUtils::GetPublicHnpOwnerId(profileContent);
+            }
+            bool signFlag = SignHnpFile(tempPath, entryName, currentOwnerID, ret);
+            std::remove(tempPath.c_str());
+            if (!signFlag) {
+                unzClose(zFile);
+                return false;
+            }
+        }
+        if (i != zGlobalInfo.number_entry - 1 && unzGoToNextFile(zFile) != UNZ_OK) {
+            PrintErrorNumberMsg("SIGN_ERROR", SIGN_ERROR, "zlib go to next file failed.");
+            unzClose(zFile);
+            return false;
+        }
+    }
+    unzClose(zFile);
+    return true;
+}
+
+bool CodeSigning::SignHnpFile(const std::string& hnpPath, const std::string& hnpEntryName, const std::string& ownerID,
+    std::vector<std::pair<std::string, SignInfo>>& ret)
+{
+    unzFile hnpFile = unzOpen(hnpPath.c_str());
+    if (hnpFile == nullptr) {
+        PrintErrorNumberMsg("IO_ERROR", IO_ERROR, "zlib open file: " + hnpPath + " failed.");
+        return false;
+    }
+    unz_global_info zGlobalInfo;
+    if (unzGetGlobalInfo(hnpFile, &zGlobalInfo) != UNZ_OK) {
+        PrintErrorNumberMsg("SIGN_ERROR", SIGN_ERROR, "zlib get hnp global info failed.");
+        unzClose(hnpFile);
+        return false;
+    }
+    for (uLong i = 0; i < zGlobalInfo.number_entry; ++i) {
+        unz_file_info zFileInfo;
+        char fileName[FILE_NAME_SIZE] = {0};
+        if (unzGetCurrentFileInfo(hnpFile, &zFileInfo, fileName, FILE_NAME_SIZE, NULL, 0, NULL, 0) != UNZ_OK) {
+            PrintErrorNumberMsg("SIGN_ERROR", SIGN_ERROR, "unzip get hnp file info failed!");
+            unzClose(hnpFile);
+            return false;
+        }
+        std::string innerEntryName(fileName);
+        bool isDirectory = !innerEntryName.empty() && innerEntryName.back() == '/';
+        if (!isDirectory) {
+            int readFileSize = 0;
+            std::stringbuf sb;
+            if (!GetSingleFileStreamFromZip(hnpFile, fileName, zFileInfo, readFileSize, sb)) {
+                unzClose(hnpFile);
+                return false;
+            }
+            std::string fileContent = sb.str();
+            if (IsElfData(fileContent)) {
+                std::istream input(&sb);
+                std::pair<SignInfo, std::vector<int8_t>> signResult;
+                if (!SignFile(input, readFileSize, false, 0, ownerID, signResult)) {
+                    unzClose(hnpFile);
+                    return false;
+                }
+                ret.emplace_back(hnpEntryName + "!/" + innerEntryName, signResult.first);
+            }
+        }
+        if (i != zGlobalInfo.number_entry - 1 && unzGoToNextFile(hnpFile) != UNZ_OK) {
+            PrintErrorNumberMsg("SIGN_ERROR", SIGN_ERROR, "zlib go to next hnp file failed.");
+            unzClose(hnpFile);
+            return false;
+        }
+    }
+    unzClose(hnpFile);
+    return true;
+}
+
+bool CodeSigning::IsHnpFile(const std::string& entryName)
+{
+    if (entryName.size() <= HNP_PATH_PREFIX.size() || entryName.rfind(HNP_PATH_PREFIX, 0) != 0) {
+        return false;
+    }
+    std::string lowerEntryName = entryName;
+    std::transform(lowerEntryName.begin(), lowerEntryName.end(), lowerEntryName.begin(), ::tolower);
+    return lowerEntryName.size() >= HNP_SUFFIX.size() &&
+        lowerEntryName.compare(lowerEntryName.size() - HNP_SUFFIX.size(), HNP_SUFFIX.size(), HNP_SUFFIX) == 0;
+}
+
+bool CodeSigning::IsElfData(const std::string& fileContent)
+{
+    return fileContent.size() >= ELF_HEADER_SIZE &&
+        static_cast<unsigned char>(fileContent[0]) == 0x7f &&
+        fileContent[1] == 'E' &&
+        fileContent[2] == 'L' &&
+        fileContent[3] == 'F';
+}
+
+bool CodeSigning::CreateTempFilePath(const std::string& suffix, std::string& tempPath)
+{
+    std::error_code ec;
+    std::filesystem::path baseDir = std::filesystem::temp_directory_path(ec);
+    if (ec) {
+        baseDir = std::filesystem::current_path(ec);
+    }
+    if (ec) {
+        PrintErrorNumberMsg("IO_ERROR", IO_ERROR, "create temporary file path failed");
+        return false;
+    }
+    uint64_t uniqueId = g_tempFileIndex.fetch_add(1);
+    std::filesystem::path tempFile = baseDir /
+        ("hapsigntool_cpp_hnp_" + std::to_string(static_cast<long long>(std::time(nullptr))) +
+        "_" + std::to_string(static_cast<unsigned long long>(uniqueId)) + suffix);
+    tempPath = tempFile.string();
+    return true;
+}
+
+bool CodeSigning::ExtractCurrentFileToPath(unzFile& zFile, const std::string& outPath)
+{
+    if (unzOpenCurrentFile(zFile) != UNZ_OK) {
+        PrintErrorNumberMsg("SIGN_ERROR", SIGN_ERROR, "unzOpenCurrentFile zipFile error");
+        return false;
+    }
+    std::ofstream outFile(outPath, std::ios::binary);
+    if (!outFile.is_open()) {
+        PrintErrorNumberMsg("IO_ERROR", IO_ERROR, "open output file: " + outPath + " failed");
+        unzCloseCurrentFile(zFile);
+        return false;
+    }
+    char readBuffer[BUFFER_SIZE] = {0};
+    int readLen = 0;
+    while ((readLen = unzReadCurrentFile(zFile, readBuffer, BUFFER_SIZE)) > 0) {
+        outFile.write(readBuffer, readLen);
+        if (!outFile.good()) {
+            PrintErrorNumberMsg("IO_ERROR", IO_ERROR, "write temp hnp file failed: " + outPath);
+            unzCloseCurrentFile(zFile);
+            return false;
+        }
+    }
+    unzCloseCurrentFile(zFile);
+    outFile.close();
+    if (readLen < 0) {
+        PrintErrorNumberMsg("SIGN_ERROR", SIGN_ERROR, "read current zip entry failed");
+        return false;
+    }
+    return true;
+}
