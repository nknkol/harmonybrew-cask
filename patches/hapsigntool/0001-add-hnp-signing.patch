+bool VerifyCodeSignature::VerifyNativeEntry(unzFile& zFile, const std::string& entryName, const SignInfo& signInfo,
+    const std::string& ownerID, const std::string& profileType)
+{
+    SignInfo signInfoCopy = signInfo;
+    if (unzLocateFile(zFile, entryName.c_str(), 0) != UNZ_OK) {
+        PrintErrorNumberMsg("VERIFY_ERROR", VERIFY_ERROR, "verify signed file position failed, file: " + entryName);
+        return false;
+    }
+    unz_file_info zFileInfo;
+    char fileName[512] = {0};
+    if (unzGetCurrentFileInfo(zFile, &zFileInfo, fileName, sizeof(fileName), NULL, 0, NULL, 0) != UNZ_OK) {
+        PrintErrorNumberMsg("VERIFY_ERROR", VERIFY_ERROR, "failed to read zip entry info: " + entryName);
+        return false;
+    }
+    int readFileSize = 0;
+    std::stringbuf sb;
+    CodeSigning codeSigning;
+    if (!codeSigning.GetSingleFileStreamFromZip(zFile, fileName, zFileInfo, readFileSize, sb)) {
+        return false;
+    }
+    if (readFileSize != signInfoCopy.GetDataSize()) {
+        PrintErrorNumberMsg("VERIFY_ERROR", VERIFY_ERROR, "Invalid dataSize of native lib");
+        return false;
+    }
+    std::istream input(&sb);
+    std::vector<int8_t> signature = signInfoCopy.GetSignature();
+    if (!VerifySingleFile(input, readFileSize, signature, 0, std::vector<int8_t>())) {
+        return false;
+    }
+    std::string signatureStr(signature.begin(), signature.end());
+    return CmsUtils::CheckOwnerID(signatureStr, ownerID, profileType);
+}
+
+bool VerifyCodeSignature::VerifyHnpFile(const std::string& hnpPath, const std::string& hnpEntryName,
+    std::unordered_map<std::string, SignInfo>& hnpLibSignInfoMap,
+    std::unordered_map<std::string, std::string>& hnpTypeMap,
+    std::pair<std::string, std::string>& pairResult)
+{
+    std::string hnpFileName = HapUtils::ParseHnpPath(hnpEntryName);
+    auto hnpTypeIt = hnpTypeMap.find(hnpFileName);
+    if (hnpTypeIt == hnpTypeMap.end()) {
+        PrintErrorNumberMsg("VERIFY_ERROR", VERIFY_ERROR, "hnp should be described in module.json");
+        return false;
+    }
+    unzFile hnpFile = unzOpen(hnpPath.c_str());
+    if (hnpFile == nullptr) {
+        PrintErrorNumberMsg("IO_ERROR", IO_ERROR, "zlib open file: " + hnpPath + " failed.");
+        return false;
+    }
+    unz_global_info zGlobalInfo;
+    if (unzGetGlobalInfo(hnpFile, &zGlobalInfo) != UNZ_OK) {
+        PrintErrorNumberMsg("VERIFY_ERROR", VERIFY_ERROR, "zlib get hnp global info failed.");
+        unzClose(hnpFile);
+        return false;
+    }
+    std::unordered_set<std::string> expectedLibPaths;
+    for (const auto& item : hnpLibSignInfoMap) {
+        if (item.first.rfind(hnpEntryName + "!/", 0) == 0) {
+            expectedLibPaths.insert(item.first);
+        }
+    }
+    std::unordered_set<std::string> verifiedLibPaths;
+    CodeSigning codeSigning;
+    for (uLong i = 0; i < zGlobalInfo.number_entry; ++i) {
+        unz_file_info zFileInfo;
+        char fileName[512] = {0};
+        if (unzGetCurrentFileInfo(hnpFile, &zFileInfo, fileName, sizeof(fileName), NULL, 0, NULL, 0) != UNZ_OK) {
+            PrintErrorNumberMsg("VERIFY_ERROR", VERIFY_ERROR, "unzip get hnp file info failed!");
+            unzClose(hnpFile);
+            return false;
+        }
+        std::string innerEntryName(fileName);
+        std::string libPath = hnpEntryName + "!/" + innerEntryName;
+        bool isDirectory = !innerEntryName.empty() && innerEntryName.back() == '/';
+        if (!isDirectory && hnpLibSignInfoMap.find(libPath) != hnpLibSignInfoMap.end()) {
+            int readFileSize = 0;
+            std::stringbuf sb;
+            if (!codeSigning.GetSingleFileStreamFromZip(hnpFile, fileName, zFileInfo, readFileSize, sb)) {
+                unzClose(hnpFile);
+                return false;
+            }
+            SignInfo signInfo = hnpLibSignInfoMap[libPath];
+            if (readFileSize != signInfo.GetDataSize()) {
+                PrintErrorNumberMsg("VERIFY_ERROR", VERIFY_ERROR, "Invalid dataSize of native lib");
+                unzClose(hnpFile);
+                return false;
+            }
+            std::istream input(&sb);
+            if (!VerifySingleFile(input, readFileSize, signInfo.GetSignature(), 0, std::vector<int8_t>())) {
+                unzClose(hnpFile);
+                return false;
+            }
+            if (!CheckHnpOwnerID(signInfo.GetSignature(), pairResult.first, pairResult.second, hnpTypeIt->second)) {
+                unzClose(hnpFile);
+                return false;
+            }
+            verifiedLibPaths.insert(libPath);
+        }
+        if (i != zGlobalInfo.number_entry - 1 && unzGoToNextFile(hnpFile) != UNZ_OK) {
+            PrintErrorNumberMsg("VERIFY_ERROR", VERIFY_ERROR, "zlib go to next hnp file failed.");
+            unzClose(hnpFile);
+            return false;
+        }
+    }
+    unzClose(hnpFile);
+    if (verifiedLibPaths.size() != expectedLibPaths.size()) {
+        PrintErrorNumberMsg("VERIFY_ERROR", VERIFY_ERROR, "verify signed file position failed in hnp: " + hnpEntryName);
+        return false;
+    }
+    return true;
+}
+
+bool VerifyCodeSignature::CheckHnpOwnerID(const std::vector<int8_t>& signature, const std::string& profileOwnerID,
+    const std::string& profileType, const std::string& hnpType)
+{
+    std::string ownerID = profileOwnerID;
+    if (profileType == "debug") {
+        ownerID = "DEBUG_LIB_ID";
+    } else if (profileType == "release" && hnpType == "public") {
+        ownerID = "SHARED_LIB_ID";
+    }
+    std::string signatureStr(signature.begin(), signature.end());
+    return CmsUtils::CheckOwnerID(signatureStr, ownerID, profileType);
+}
