-#else /* RSEQ_SIG */
+/* HarmonyOS workaround: the HongMeng kernel implements neither the rseq
+   syscall nor a graceful ENOSYS for it; issuing the syscall triggers a
+   fatal SIGSYS (via its seccomp path) instead of a return value.  Avoid
+   the syscall entirely and always report registration as failed, which is
+   exactly what glibc does when rseq is unavailable.  */
 static inline bool
 rseq_register_current_thread (struct pthread *self, bool do_rseq)
 {
+  (void) do_rseq;
   THREAD_SETMEM (self, rseq_area.cpu_id, RSEQ_CPU_ID_REGISTRATION_FAILED);
   return false;
 }
