# OpenAI Codex & codex-exec-server in-memory ELF patch configuration
PROGRAM @PROGRAM@

# 1. Redirect daemon socket directory format literal ("\x0dcodex-daemon-\xc0\x00")
#    to writable HarmonyOS cache ("\x20/data/storage/el2/base/cache/cd-\xc0\x00")
TARGET daemon_socket_dir REQUIRED
  REDIRECT_ADRP 0d636f6465782d6461656d6f6e2dc000 202f646174612f73746f726167652f656c322f626173652f63616368652f63642dc000

# 2. Disable close_range site #1 (replace BL syscall with MOV X0, #-1 so fallback runs)
TARGET close_range_site_1 REQUIRED
  SEARCH 8036805283008052??????9480????b4 8 00008092
  SEARCH 8036805283008052????????80????b4 8 00008092
  OFFSET 0xb8717b4 803680528300805227d5689480fbffb4 ????????????????00008092
  OFFSET 0x2398b3c 8036805283008052f146459480fbffb4 ????????????????00008092

# 3. Disable close_range site #2 (replace BL syscall with MOV X0, #-1 so fallback runs)
TARGET close_range_site_2 REQUIRED
  SEARCH 80368052610080520200801283008052??????94e0????b4 16 00008092
  SEARCH 80368052610080520200801283008052????????e0????b4 16 00008092
  OFFSET 0xb8717c8 8036805261008052020080128300805220d56894e02100b4 ????????????????????????????????00008092
  OFFSET 0x2398b50 80368052610080520200801283008052ea464594e02100b4 ????????????????????????????????00008092
